legacy/
.port-bin
.port-bin.js
.port-bin.gpu
__pycache__/
port/*.c
port/*.js
# the one custom effect's twins are SOURCE, not build output (port/main.bend imports them)
!port/stdin_open.c
!port/stdin_open.js
port/*.gpu
port/toon
# README's Quick Start builds `bend port/main.bend -o toon` at the root (round 14, R14-13)
/toon
/toon.js
.ruff_cache/
oracle/
/-
# the real-world benchmark documents and their TOON twins (python3 perf/e2e/bench.py fetch / prepare)
/perf/e2e/corpus/
# bench.py run: the verification run's /usr/bin/time scratch file
perf/e2e/results/*/.rss

# git's own merge/rebase leftovers (*.orig) and gprof's output. Both are tool artifacts that appear in
# the working checkout and should never be tracked; ignoring them is not deleting them, and the files
# already present are left in place.
*.orig
gmon.out
