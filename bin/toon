#!/bin/sh
# toon: launcher of the Bend 2 port. It gives the original's command line unchanged:
#   - DISC-001: a compiled Bend binary consumes --help, --threads N and --gpu X before `--`;
#     the launcher passes `--` first, so every word the user typed reaches the port's argv.
#   - DISC-007: a CLOSED standard descriptor is taken by the native runtime's own wake-up pipe at
#     startup (descriptor numbers are given out lowest first): a read of stdin then fails, and output
#     above 64 KiB written "to stdout" fills that pipe and never returns. The original sees an empty
#     stdin and ignores EBADF on stdout and stderr, which is exactly what /dev/null gives: closed
#     descriptors 0, 1 and 2 are re-opened from /dev/null before exec.
# The binary is port/toon (build it: $BEND_CLI port/main.bend -o port/toon), or $TOON_BEND_BIN.
# Runtime knobs go through the environment, never argv: TOON_BEND_THREADS=N (a positive decimal count;
# anything else is ignored), TOON_SPEC=1.
# the launcher may be reached through symbolic links (a link in ~/.local/bin): the binary is beside the FILE
self=$0
while [ -L "$self" ]; do
  link=$(readlink -- "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
here=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd) || exit 127
bin=${TOON_BEND_BIN:-$here/../port/toon}
if [ ! -x "$bin" ]; then
  echo "toon: no binary at $bin (build it: bun /tmp/bend/bend2/main.ts port/main.bend -o port/toon)" >&2
  exit 127
fi
# duplicating a closed descriptor fails with EBADF; the subshell keeps descriptor 3 out of this process.
# Descriptor 2 is asked through /dev/fd, because silencing the test itself would re-open it.
if ! (exec 3<&0) 2>/dev/null; then
  exec 0</dev/null
fi
if ! (exec 3>&1) 2>/dev/null; then
  exec 1>/dev/null
fi
if [ ! -e /dev/fd/2 ]; then
  exec 2>/dev/null
fi
# DISC-003, DISC-006 (round 8): a standard descriptor that is OPEN in the wrong access mode (`1</dev/null`,
# `2</dev/null`) gives EBADF on its first write; the original ignores that and the Bend runtime stops with
# exit 1. Linux tells the access mode in /proc/self/fdinfo/N (`flags:`, octal; the last digit 0 or 4 is
# read-only, 1 or 5 write-only): a read-only 1 or 2 becomes /dev/null, which is what "ignored" amounts to.
wrong_mode() {
  [ -r "/proc/self/fdinfo/$1" ] || return 1
  flags=
  while read -r key value; do
    [ "$key" = flags: ] && flags=$value
  done < "/proc/self/fdinfo/$1"
  case $flags in
    *[04]) [ "$2" = write ] ;;
    *[15]) [ "$2" = read ] ;;
    *) return 1 ;;
  esac
}
if wrong_mode 1 write; then
  exec 1>/dev/null
fi
if wrong_mode 2 write; then
  exec 2>/dev/null
fi
# a thread count that the runtime would refuse (it refuses for EVERY argv, --version included) is not passed on
case ${TOON_BEND_THREADS:-} in
  '' | *[!0-9]* | 0*) exec "$bin" -- "$@" ;;
  *) exec "$bin" --threads "$TOON_BEND_THREADS" -- "$@" ;;
esac
