+# ---------------------------------------------------------------- PAR the numbers rendered before emission
+#
+# Every number's text depends on that number alone, so it is rendered by a pass BEFORE emission, which
+# forks long item chains into halves (parallel lets: the runtime's worker pool, or a device under a bang).
+# The emitter then copies the text (JTxt). Modes: PVal a value; PSeq the rest of an item chain, walked
+# sequentially onto acc; PPar an item chain of n items, split while it is long.
+
+# PAR the pass's mode: a value; the rest of an item or entry chain walked sequentially (collected onto acc);
+# an item chain of n items; a chain cut in two (split when long, else walked sequentially)
+type PM is Data:
+  PVal{}
+  PSeq{}
+  PPar{n: Nat}
+  PCut{long: Bool, n: Nat, left: J.Json, right: J.Json}
+
+# PAR the first k items of a chain, in order, and the rest
+type PS is Data:
+  PS{left: J.Json, right: J.Json}
+
+# PAR take k items off a chain (collected reversed onto acc, turned back at the end)
+def par.take(k: Nat, c: J.Json, acc: J.Json) -> PS:
+  match k c:
+    case 0n r:
+      PS{J.rev_items(acc, J.JNil{}), r}
+    case 1n+p J.JCons{h, t}:
+      par.take(p, t, J.JCons{h, acc})
+    case 1n+p r:
+      PS{J.rev_items(acc, J.JNil{}), r}
+
+# PAR a chain appended to another
+def par.cat(a: J.Json, b: J.Json) -> J.Json:
+  J.rev_items(J.rev_items(a, J.JNil{}), b)
+
+# PAR the chain walked sequentially was collected newest first: items or entries
+def par.back(acc: J.Json) -> J.Json:
+  match acc:
+    case J.JECons{k, q, v, t}:
+      J.rev_entries(J.JECons{k, q, v, t}, J.JNil{})
+    case other:
+      J.rev_items(other, J.JNil{})
+
+# PAR the cut of a chain of n items at n/2
+def par.cut(+n: Nat, s: PS) -> PM:
+  match s:
+    case PS{l, r}:
+      PCut{Nat.is_gt(n, 64n), n, l, r}
+
+# PAR one def over (fuel, value). A cut and a split each spend one unit of fuel; every other step descends
+# into j. A value the pass does not reach keeps its JNum, which the emitter prints itself, so running out of
+# fuel changes the speed and never the text.
+def pre(+fuel: Nat, j: J.Json, m: PM, acc: J.Json, +spec: Bool) -> J.Json:
+  match fuel j m:
+    case f J.JNum{x} PVal{}:
+      J.JTxt{F.show_toon_fast(x, spec)}
+    case f J.JRaw{neg, ints, fracs, eneg, x} PVal{}:
+      J.JTxt{F.show_toon_fast(J.raw.f64(neg, ints, fracs, eneg, x, spec), spec)}
+    case f J.JArr{+n, items} PVal{}:
+      J.JArr{n, pre(f, items, PPar{n}, J.JNil{}, spec)}
+    case f J.JObj{e} PVal{}:
+      J.JObj{pre(f, e, PSeq{}, J.JNil{}, spec)}
+    case f J.JCons{h, t} PSeq{}:
+      pre(f, t, PSeq{}, J.JCons{pre(f, h, PVal{}, J.JNil{}, spec), acc}, spec)
+    case f J.JECons{k, q, v, t} PSeq{}:
+      pre(f, t, PSeq{}, J.JECons{k, q, pre(f, v, PVal{}, J.JNil{}, spec), acc}, spec)
+    case f J.JNil{} PSeq{}:
+      par.back(acc)
+    case 1n++p c PPar{+n}:
+      pre(p, J.JNil{}, par.cut(n, par.take(Nat.div(n, 2n), c, J.JNil{})), acc, spec)
+    case 1n++p z PCut{True{}, +n, l, r}:
+      a b = pre(p, l, PPar{Nat.div(n, 2n)}, J.JNil{}, spec) pre(p, r, PPar{Nat.sub(n, Nat.div(n, 2n))}, J.JNil{}, spec)
+      par.cat(a, b)
+    case 1n+p z PCut{False{}, n, l, r}:
+      pre(p, par.cat(l, r), PSeq{}, J.JNil{}, spec)
+    case 0n z PCut{long, n, l, r}:
+      par.cat(l, r)
+    case f v m:
+      v
+
 # S4.60 the TOON lines of a value, in order (an empty root object gives no line)
-def encode(+j: J.Json, +opt: Opts) -> List<&2, String>:
+def encode.go(+j: J.Json, +opt: Opts) -> List<&2, String>:
   List.reverse(&2, String, emit(j, ctx.root(j, opt), opt, Nil{}))
+
+# PAR render every number first (in parallel), then emit
+def encode(j: J.Json, +opt: Opts) -> List<&2, String>:
+  encode.go(pre(64n, j, PVal{}, J.JNil{}, opt.spec(opt)), opt)
