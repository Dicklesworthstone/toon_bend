# port.env: the port's knobs, read by scripts/port.sh (see port.sh --help)
ORIGINAL="./oracle/toon"
THREADS=8
SWITCH=TOON_SPEC=1
PROBE='["--encode","cases/inputs/hand/large_tabular_1500.json"]'
HOT='["--encode","cases/inputs/hand/large_tabular_1500.json"]'
PIN="toon_rust f955c67 (toon 0.2.4), rustc 1.100.0-nightly 2026-08-30, cargo build --release (opt-level=z lto codegen-units=1 panic=abort strip), 1 thread"
MAIN=port/main.bend
CASES=goldens/cases.tsv
GOLDENS=goldens
QUIET=0
